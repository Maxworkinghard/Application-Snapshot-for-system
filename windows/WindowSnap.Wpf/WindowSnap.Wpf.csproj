<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM 用 22621 让 IsBorderRequired 等新 API 可编译；实际最低运行版本由 SupportedOSPlatformVersion 决定 -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WindowSnap.Wpf</RootNamespace>
    <AssemblyName>WindowSnap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 具体架构在 publish 时用 -r win-x64 / win-arm64 指定（见 build.ps1） -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Company>WindowSnap</Company>
    <Product>应用快照</Product>
    <NoWarn>$(NoWarn);CS0067;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标为可选资源：文件不存在时 glob 为空，构建不报错 -->
    <Resource Include="Resources\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.cs">
      <SubType>Code</SubType>
    </None>
  </ItemGroup>

</Project>
